  " style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;strokeWidth=1.5;fontFamily=Segoe UI,Helvetica,Arial;align=left;spacingLeft=14;spacingRight=14;shadow=0;" vertex="1" parent="1">
